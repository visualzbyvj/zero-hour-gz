<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.2.1</Version>
  <Author>VJ + Codex (manual 7CH busk profile)</Author>
 </Creator>
 <Manufacturer>SHEHDS</Manufacturer>
 <Model>30W COB-RGB</Model>
 <Type>Color Changer</Type>

 <Channel Name="Master Dimmer" Default="255">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="255">Total Dimming (Dark to Bright)</Capability>
 </Channel>
 <Channel Name="Red" Preset="IntensityRed">
  <Group Byte="0">Intensity</Group>
  <Colour>Red</Colour>
  <Capability Min="0" Max="255">Red Intensity</Capability>
 </Channel>
 <Channel Name="Green" Preset="IntensityGreen">
  <Group Byte="0">Intensity</Group>
  <Colour>Green</Colour>
  <Capability Min="0" Max="255">Green Intensity</Capability>
 </Channel>
 <Channel Name="Blue" Preset="IntensityBlue">
  <Group Byte="0">Intensity</Group>
  <Colour>Blue</Colour>
  <Capability Min="0" Max="255">Blue Intensity</Capability>
 </Channel>
 <Channel Name="RGB Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="5">Open / No Strobe</Capability>
  <Capability Min="6" Max="255">RGB Strobe Slow to Fast</Capability>
 </Channel>
 <Channel Name="Program Select">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="50">Manual RGB Dimming</Capability>
  <Capability Min="51" Max="100">Preset Color Mode</Capability>
  <Capability Min="101" Max="150">Auto Mode 1</Capability>
  <Capability Min="151" Max="200">Auto Mode 2</Capability>
  <Capability Min="201" Max="250">Auto Mode 3</Capability>
  <Capability Min="251" Max="255">Sound Mode</Capability>
 </Channel>
 <Channel Name="Program Speed / Sensitivity">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="255">Program Speed / Sound Sensitivity</Capability>
 </Channel>

 <Mode Name="7ch Busk">
  <Channel Number="0">Master Dimmer</Channel>
  <Channel Number="1">Red</Channel>
  <Channel Number="2">Green</Channel>
  <Channel Number="3">Blue</Channel>
  <Channel Number="4">RGB Strobe</Channel>
  <Channel Number="5">Program Select</Channel>
  <Channel Number="6">Program Speed / Sensitivity</Channel>
  <Head>
   <Channel>1</Channel>
   <Channel>2</Channel>
   <Channel>3</Channel>
  </Head>
 </Mode>

 <Physical>
  <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="0" Width="0" Height="0" Depth="0"/>
  <Lens Name="Other" DegreesMin="15" DegreesMax="60"/>
  <Focus Type="Fixed" PanMax="0" TiltMax="0"/>
  <Technical PowerConsumption="30" DmxConnector="3-pin"/>
 </Physical>
</FixtureDefinition>
