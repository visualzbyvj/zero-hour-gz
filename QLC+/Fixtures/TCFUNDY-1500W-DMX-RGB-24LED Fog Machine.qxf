<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.2.1</Version>
  <Author>VJ + Codex (7CH — TCFUNDY official spec + OEM family cross-ref)</Author>
 </Creator>
 <Manufacturer>TCFUNDY</Manufacturer>
 <Model>1500W DMX RGB 3-in-1 24LED Fog Machine</Model>
 <Type>Hazer</Type>

 <!-- ─── Channel definitions ─────────────────────────────────────── -->

 <Channel Name="Fog Output">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0"   Max="9"  >Fog Off</Capability>
  <Capability Min="10"  Max="255">Fog On (low to full output)</Capability>
 </Channel>

 <Channel Name="Red" Preset="IntensityRed">
  <Group Byte="0">Intensity</Group>
  <Colour>Red</Colour>
  <Capability Min="0" Max="255">Red Intensity</Capability>
 </Channel>

 <Channel Name="Green" Preset="IntensityGreen">
  <Group Byte="0">Intensity</Group>
  <Colour>Green</Colour>
  <Capability Min="0" Max="255">Green Intensity</Capability>
 </Channel>

 <Channel Name="Blue" Preset="IntensityBlue">
  <Group Byte="0">Intensity</Group>
  <Colour>Blue</Colour>
  <Capability Min="0" Max="255">Blue Intensity</Capability>
 </Channel>

 <Channel Name="Color Macro">
  <Group Byte="0">Colour</Group>
  <Capability Min="0"   Max="9"  >Manual RGB (CH2–4 active)</Capability>
  <Capability Min="10"  Max="19" >Red</Capability>
  <Capability Min="20"  Max="29" >Green</Capability>
  <Capability Min="30"  Max="39" >Blue</Capability>
  <Capability Min="40"  Max="49" >Yellow (R+G)</Capability>
  <Capability Min="50"  Max="59" >Cyan (G+B)</Capability>
  <Capability Min="60"  Max="69" >Magenta (R+B)</Capability>
  <Capability Min="70"  Max="79" >White (R+G+B)</Capability>
  <Capability Min="80"  Max="139">Auto Color Cycle — 7 preset colors</Capability>
  <Capability Min="140" Max="199">Auto Gradient Fade — slow to fast</Capability>
  <Capability Min="200" Max="255">Sound-Active Color Chase</Capability>
 </Channel>

 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0"   Max="9"  >No Strobe (Steady)</Capability>
  <Capability Min="10"  Max="255">Strobe Speed (slow to fast)</Capability>
 </Channel>

 <Channel Name="Auto Speed">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="255">Auto / Color Chase Speed (slow to fast)</Capability>
 </Channel>

 <!-- ─── Mode ──────────────────────────────────────────────────── -->

 <Mode Name="7ch">
  <Channel Number="0">Fog Output</Channel>
  <Channel Number="1">Red</Channel>
  <Channel Number="2">Green</Channel>
  <Channel Number="3">Blue</Channel>
  <Channel Number="4">Color Macro</Channel>
  <Channel Number="5">Strobe</Channel>
  <Channel Number="6">Auto Speed</Channel>
  <Head>
   <Channel>1</Channel>
   <Channel>2</Channel>
   <Channel>3</Channel>
  </Head>
 </Mode>

 <Physical>
  <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="7" Width="510" Height="260" Depth="360"/>
  <Lens Name="Other" DegreesMin="0" DegreesMax="360"/>
  <Focus Type="Fixed" PanMax="0" TiltMax="0"/>
  <Technical PowerConsumption="1500" DmxConnector="3-pin"/>
 </Physical>
</FixtureDefinition>
