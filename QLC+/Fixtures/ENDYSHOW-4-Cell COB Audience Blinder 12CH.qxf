  <Capability Min="101" Max="150">Gradual Fade Effect</Capability>
  <Capability Min="151" Max="200">Sudden Change Effect</Capability>
  <Capability Min="201" Max="255">Sound Jump Effect</Capability>
 </Channel>
 <Channel Name="Effect Speed">
  <Group Byte="0">Speed</Group>
  <Capability Min="1" Max="255">Built in mode Speed Adjustment</Capability>
 </Channel>
